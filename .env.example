# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Azure OpenAI (chat + embeddings). An endpoint containing "/openai/v1" switches
# the client to the Responses API style.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Optional; defaults to 2024-10-21.
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_EMBEDDING_MODEL=

# Cohere rerank on Azure (only needed when the reranker is enabled in pipeline_config.yaml).
AZURE_COHERE_RERANK_ENDPOINT=
AZURE_COHERE_RERANK_API_KEY=
