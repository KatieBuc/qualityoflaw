<|ref|>text<|/ref|><|det|>[[142, 881, 300, 893]]<|/det|>
a. kemiskinan; 

<|ref|>text<|/ref|><|det|>[[142, 896, 307, 908]]<|/det|>
b. ketelantaran; 

<|ref|>text<|/ref|><|det|>[[142, 911, 275, 923]]<|/det|>
c. kecacatan; 

<|ref|>text<|/ref|><|det|>[[142, 926, 315, 939]]<|/det|>
d. keterpencilan;

<--- Page Split --->
<|ref|>text<|/ref|><|det|>[[145, 91, 620, 105]]<|/det|>
e. ketunaan sosial dan penyimpangan perilaku; 

<|ref|>text<|/ref|><|det|>[[145, 107, 444, 120]]<|/det|>
f. korban bencana; dan/atau 

<|ref|>text<|/ref|><|det|>[[144, 122, 716, 136]]<|/det|>
g. korban tindak kekerasan, eksploitasi dan diskriminasi. 

<|ref|>text<|/ref|><|det|>[[117, 137, 886, 167]]<|/det|>
(3) Kesejahteraan sosial sebagaimana dimaksud pada ayat (1) dapat berupa penyediaan layanan: 

<|ref|>text<|/ref|><|det|>[[145, 168, 290, 180]]<|/det|>
a. kesehatan; 

<|ref|>text<|/ref|><|det|>[[145, 183, 297, 195]]<|/det|>
b. pendidikan; 

<|ref|>text<|/ref|><|det|>[[145, 198, 347, 210]]<|/det|>
c. bantuan hukum; 

<|ref|>text<|/ref|><|det|>[[145, 213, 338, 226]]<|/det|>
d. pendampingan; 

<|ref|>text<|/ref|><|det|>[[145, 228, 561, 242]]<|/det|>
e. bimbingan sosial, mental dan spiritual; 

<|ref|>text<|/ref|><|det|>[[145, 244, 456, 257]]<|/det|>
f. rehabilitasi sosial; dan/atau 

<|ref|>text<|/ref|><|det|>[[145, 259, 290, 272]]<|/det|>
g. reintegrasi. 

